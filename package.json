{
  "name": "outline-electron-client",
  "version": "0.1.0",
  "description": "Electron desktop client wrapper for self-hosted Outline with meeting recording experiments.",
  "private": true,
  "author": "tukadlab",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle:preload && npm run bundle:chrome",
    "bundle:preload": "esbuild src/preload/index.ts --bundle --platform=browser --format=cjs --external:electron --outfile=dist/preload/index.js",
    "bundle:chrome": "esbuild src/preload/chrome.ts --bundle --platform=browser --format=cjs --external:electron --outfile=dist/preload/chrome.js",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -p tsconfig.json --noEmit --watch",
    "dist:win": "npm run build && electron-builder --win --x64",
    "pack:win": "npm run build && electron-builder --win --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "pack:mac": "npm run build && electron-builder --mac --dir"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.tukadlab.outline-electron-client",
    "productName": "Outline Electron Client",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Outline Electron Auth Link",
        "schemes": [
          "outline-electron"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Outline"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "회의 녹음을 위해 마이크에 접근합니다.",
        "NSCameraUsageDescription": "화면/시스템 오디오 캡처를 위해 미디어 장치에 접근합니다.",
        "NSAudioCaptureUsageDescription": "회의 녹음을 위해 시스템 오디오를 캡처합니다."
      }
    },
    "dmg": {
      "title": "Outline",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.1": true
  }
}
